# Copy to .env and edit. Real environment variables win over this file.
# Never commit .env or put real secrets here.

# --- backend ---
HTTP_ADDR=:8080                      # REST and /ws
TCP_ADDR=:9090                       # progress sync
UDP_ADDR=:9091                       # chapter alerts
CATALOG_ADDR=127.0.0.1:9092          # gRPC target of the catalog
GRPC_TIMEOUT=2s                      # per-call deadline
BACKEND_DB_PATH=var/backend.db       # users + library
JWT_SECRET=change-me-to-a-long-random-string   # REQUIRED, >= 16 chars: change it
JWT_TTL=24h
ADMIN_USERNAME=admin                 # demo admin seeding
ADMIN_PASSWORD=change-me-admin-pw    # REQUIRED for the admin: change it
REDIS_ENABLED=false                  # optional cache (Phase 12)
REDIS_ADDR=127.0.0.1:6379
CACHE_TTL=30s

# --- catalog ---
GRPC_ADDR=:9092                      # gRPC listen address
CATALOG_DB_PATH=var/catalog.db       # manga
# SEED_PATH=                         # optional override of the embedded seed file

# --- tui (same as --api/--tcp/--udp/--ws flags) ---
MANGAHUB_API=http://127.0.0.1:8080
MANGAHUB_TCP=127.0.0.1:9090
MANGAHUB_UDP=127.0.0.1:9091
MANGAHUB_WS=ws://127.0.0.1:8080/ws

# --- all programs ---
LOG_LEVEL=info
